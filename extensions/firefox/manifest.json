{
  "manifest_version": 2,
  "name": "Discord Token Manager",
  "description": "A quiet utility for managing saved Discord session tokens.",
  "version": "1.4.1",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "https://discord.com/*",
    "https://*.discord.com/*",
    "https://cdn.discordapp.com/*",
    "http://127.0.0.1:47474/*"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Discord Token Manager",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "scripts": [
      "bridge.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://discord.com/*",
        "https://*.discord.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "discord-token-manager@example.com",
      "strict_min_version": "91.0"
    }
  }
}
